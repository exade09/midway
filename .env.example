# ── Chain ──────────────────────────────────────────────
# Helius key: server RPC, wallet scan, burn verification and cost basis (swap history).
HELIUS_API_KEY=
# Optional fallback RPC when no Helius key is set.
# RPC_URL=https://api.mainnet-beta.solana.com

# ── The pot ────────────────────────────────────────────
# Public address that receives the pot cut of every burial and pays the nightly winner.
NEXT_PUBLIC_POT_WALLET=
# Pot cut in basis points of reclaimed rent (500 = 5%).
NEXT_PUBLIC_POT_CUT_BPS=500
# Hour (UTC) the nightly draw closes. 18 = 21:00 MSK. Keep vercel.json's cron in step.
NEXT_PUBLIC_DRAW_HOUR_UTC=18
# Secret key of the pot wallet as a JSON byte array. Leave empty to pay winners by hand.
DRAW_PAYOUT_SECRET=
# Vercel sends this as a bearer token to the cron route.
CRON_SECRET=

# ── Storage ────────────────────────────────────────────
# Neon/Postgres. Without it, a JSON file in /tmp is used (dev only).
DATABASE_URL=

# ── The Barker ─────────────────────────────────────────
# Optional: Claude writes the Barker's lines. Without it he speaks from templates.
ANTHROPIC_API_KEY=
BARKER_MODEL=claude-haiku-4-5

NEXT_PUBLIC_SITE_URL=https://midway.fun

# ── Token ──────────────────────────────────────────────
# Contract address shown (and copyable) in the header. Leave empty to show "soon".
NEXT_PUBLIC_TOKEN_CA=
